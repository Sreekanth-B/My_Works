###################### Creating Access Token for Azure App

properties = {
    "databricks_sp_secret_key": "<DBX Key> ",
    "databricks_sp_secret_scope": "<DBX Scope>",
    "databricks_sp_object_id": "<Azure App client ID>",
    "databricks_sp_tenant_id": "<Azure App tenant ID>",    
    "is_initial_load": True
}
# #Get azure token
from msal import ConfidentialClientApplication

service_principal_id = properties["databricks_sp_object_id"]

service_principal_secret = properties["databricks_sp_secret_scope"] #databricks_sp_secret

authority = (
    "https://login.microsoftonline.com/" + properties["databricks_sp_tenant_id"]
)

resource = "https://database.windows.net//.default"

app = ConfidentialClientApplication(
    client_id=service_principal_id,
    client_credential=service_principal_secret,
    authority=authority,
)
result = app.acquire_token_for_client(scopes=[resource])
prod_token = result["access_token"]

print(prod_token)



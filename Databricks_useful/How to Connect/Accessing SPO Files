print(response.status_code)

if response.status_code == 200:
    xlsx_data = io.BytesIO(response.content)
    df_read_2 = pd.read_excel(xlsx_data, engine='openpyxl')
    display(df_read_2)
else:
    print(f"Failed to download file: {response.text}")


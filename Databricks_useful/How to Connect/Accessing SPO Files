if response.status_code == 200:
    xlsx_data = io.BytesIO(response.content)
    # Specify the sheet name you want to read
    df_read_3 = pd.read_excel(xlsx_data, sheet_name='sheet 6', engine='openpyxl')
    display(df_read_3)
else:
    print(f"Failed to download file: {response.text}")

## Below Code does - 1.Parses a SQL view definition string, 2.Extracts the table name and the storage path, 
3.Builds a CREATE TABLE ... USING DELTA LOCATION ... SQL statement, 4.Executes it in Spark to create the table. 

## Overall this will take above view definition from df and splits it into table name and adls location to create table in Databricks

import re
from pyspark.sql.utils import AnalysisException
def transform_view_defs(view_def):
    try:
        table_name = re.search(r"view [\w.]*", view_def)[0].split(" ")[1]
    except TypeError as e:
        raise TypeError("Could find table name in the definition!")
    try:
        location = 'abfss://<container>@<>adls.dfs.core.windows.net/'+re.search(r"bulk\s*'[\w_\/]*", view_def)[0].split("'")[1]
    except TypeError as e:
        raise TypeError("Could find location in the definition!")
    s = f'CREATE TABLE IF NOT EXISTS {table_name} USING DELTA LOCATION "{location}"'
    spark.sql(s)



errordata={"Table_name":[], "error":[]}
